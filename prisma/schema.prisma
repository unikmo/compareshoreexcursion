generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// CSE - Port Data
model Port {
  id               String   @id @default(uuid())
  slug             String   @unique
  name             String
  region           String   // "Mediterranean", "Caribbean", "Alaska"
  country          String
  timezone         String?
  description      String?
  imageUrl         String?  @map("image_url")
  coordinates      String?  // JSON: {lat, lng}
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ports")
}

// CSE - Cruise Ship Data
model CruiseShip {
  id              String           @id @default(uuid())
  shipName        String           @map("ship_name")
  cruiseLine      String           @map("cruise_line")
  cruiseSchedules CruiseSchedule[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@unique([shipName, cruiseLine])
  @@map("cruise_ships")
}

// CSE - Cruise Schedule (when ships dock at ports)
model CruiseSchedule {
  id                  String   @id @default(uuid())
  shipId              String   @map("ship_id")
  portSlug            String   @map("port_slug")
  arrivalDate         DateTime @map("arrival_date")
  arrivalTime         String?  @map("arrival_time")
  departureTime       String?  @map("departure_time")
  estimatedPassengers Int?     @map("estimated_passengers")
  source              String?
  activeStatus        String   @default("ACTIVE") @map("active_status")
  ship                CruiseShip @relation(fields: [shipId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("cruise_schedules")
}

// CSE - Group Matching Leads (waitlist for future group matching feature)
model Lead {
  id               String   @id @default(uuid())
  email            String   @unique
  firstName        String?  @map("first_name")
  lastName         String?  @map("last_name")
  phone            String?
  sailingDate      DateTime @map("sailing_date")
  sailingPort      String   @map("sailing_port")
  interestedActivities String? @map("interested_activities") // CSV or JSON
  notes            String?
  status           String   @default("SUBSCRIBED") // SUBSCRIBED, CONVERTED, BOUNCED
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("leads")
}

// CSE - Affiliate Click Tracking
model AffiliateClick {
  id              String   @id @default(uuid())
  sessionId       String?  @map("session_id")
  source          String   // "viator", "getyourguide", "shore-excursions-group", etc
  affiliateId     String?  @map("affiliate_id")
  port            String
  activity        String?
  excursionName   String?  @map("excursion_name")
  price           Int?     // in cents
  currency        String   @default("USD")
  clickedUrl      String?  @map("clicked_url")
  userAgent       String?  @map("user_agent")
  referrer        String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([source, createdAt])
  @@index([port, createdAt])
  @@map("affiliate_clicks")
}

// CSE - Cruise Line Official Excursion Pricing
model CruiseLineExcursion {
  id              String   @id @default(uuid())
  cruiseLineId    String   @map("cruise_line_id")
  cruiseLine      String   @map("cruise_line") // "Royal Caribbean", "Disney", etc
  port            String
  activity        String   // "snorkeling", "city-tour", etc
  excursionName   String   @map("excursion_name")
  description     String?
  durationMinutes Int?     @map("duration_minutes")
  pricePerPerson  Int      @map("price_per_person") // in cents
  currency        String   @default("USD")
  includedItems   String?  @map("included_items") // JSON array
  returnToShipGuarantee Boolean @default(true) @map("return_to_ship_guarantee")
  reviewScore     Float?   @map("review_score")
  reviewCount     Int?     @map("review_count")
  bookingUrl      String?  @map("booking_url")
  source          String?  // where we got this data
  lastUpdated     DateTime @map("last_updated")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([cruiseLine, port, activity])
  @@index([port])
  @@map("cruise_line_excursions")
}

// CSE - Independent Excursion Providers (Viator, GetYourGuide, etc)
model IndependentExcursion {
  id              String   @id @default(uuid())
  provider        String   // "viator", "getyourguide", "shore-excursions-group"
  providerExcursionId String @map("provider_excursion_id")
  port            String
  activity        String   // "snorkeling", "city-tour", etc
  excursionName   String   @map("excursion_name")
  description     String?
  durationMinutes Int?     @map("duration_minutes")
  pricePerPerson  Int      @map("price_per_person") // in cents
  currency        String   @default("USD")
  includedItems   String?  @map("included_items") // JSON array
  pickupLocation  String?  @map("pickup_location")
  meetingPoint    String?  @map("meeting_point")
  returnToShipGuarantee Boolean? @map("return_to_ship_guarantee")
  reviewScore     Float?   @map("review_score")
  reviewCount     Int?     @map("review_count")
  bookingUrl      String   @map("booking_url")
  affiliateUrl    String?  @map("affiliate_url")
  lastUpdated     DateTime @map("last_updated")
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([provider, providerExcursionId])
  @@index([port])
  @@index([activity])
  @@map("independent_excursions")
}
